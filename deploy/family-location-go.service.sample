[Unit]
Description=Family Location v3 Go Backend
After=network.target mysql.service

[Service]
Type=simple
WorkingDirectory=/var/www/loc-v3
ExecStart=/var/www/loc-v3/family-location-go
Restart=always
RestartSec=3
Environment=LOC_GO_ADDR=127.0.0.1:8088
Environment=LOC_PUBLIC_BASE_DIR=/var/www/loc
Environment=LOC_DB_HOST=127.0.0.1
Environment=LOC_DB_PORT=3306
Environment=LOC_DB_NAME=family_loc
Environment=LOC_DB_USER=family_loc
# /etc/family-location-v3.env should provide both LOC_DB_PASS and
# LOC_APP_SIGNING_SECRET.
EnvironmentFile=-/etc/family-location-v3.env

[Install]
WantedBy=multi-user.target
